# =======================================================
# CLARITY AI - Full Environment Template (.env.example)
# =======================================================

# --- Gemini API Configuration (Backend Only - NEVER expose to client) ---
# Obtain your key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Server Configuration ---
PORT=3000
HOST=127.0.0.1

# Allowed client origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# SQLite database file path
DATABASE_PATH=./data/clarity.sqlite

# Document storage
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=25

# --- Local Area Network (LAN) Mode ---
# Automatically set to true when running `npm run dev:lan`
LAN_MODE=false
# Optional static LAN IP override (if not auto-discovered)
# LAN_HOST_IP=192.168.1.50

# --- Frontend Client Configuration ---
# Public client configuration for Vite (DO NOT put secrets here)
# Empty in localhost mode (uses Vite /api proxy); set in LAN mode if using direct IP
VITE_API_BASE_URL=
