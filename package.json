{
  "name": "clarity-ai",
  "version": "1.0.0",
  "description": "Clarity AI - Document Research Chatbot powered by Google Gemini API",
  "type": "module",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.js --mode=local",
    "dev:local": "node scripts/dev.js --mode=local",
    "dev:lan": "node scripts/dev.js --mode=lan",
    "start": "node scripts/dev.js --mode=local",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "test:e2e": "npx tsx server/tests/e2e-live-workflow.ts",
    "test:client": "npm run test --workspace=client",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client"
  },
  "keywords": [
    "clarity-ai",
    "gemini",
    "document-research",
    "rag",
    "ai-assistant"
  ],
  "author": "Clarity AI Team",
  "license": "MIT"
}
