# ==========================================
# CLARITY AI - Backend Environment Configuration (Template)
# ==========================================

# --- Gemini API Configuration (Backend Only - NEVER expose to client) ---
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Server Configuration ---
PORT=3000
HOST=127.0.0.1

# Allowed CORS origins (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173

# Database configuration
DATABASE_PATH=./data/clarity.sqlite

# File uploads
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=25

# LAN mode configuration (true when running npm run dev:lan)
LAN_MODE=false
